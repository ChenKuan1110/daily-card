# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进公开仓库。
# 以下变量全部可选，不设置时行为与本地开发一致。

# 私有配置目录（默认 <项目根>/config）
# 适合把 themes.json / settings.json 放到仓库外单独备份
# DAILY_CARD_CONFIG=/path/to/private-config

# 远程后台地址（默认 http://127.0.0.1:8777）
# 仅影响 JSON API 调用；CLI 永远在调用方本机执行，与此无关
# DAILY_CARD_URL=https://card.example.com

# 本机 skills 目录，供 ./install.sh --link-skill 建立符号链接
# 不设置时脚本会按常见路径自动探测
# DAILY_CARD_SKILLS_DIR=/path/to/skills

# 中文字体（可选）。自动探测失败时显式指定，优先级高于 settings.json。
# 适合各发行版字体文件名/目录不标准、或多套字体共存的服务器。
# DAILY_CARD_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# DAILY_CARD_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc

# 前端静态版本根目录与保留的历史版本数（供 scripts/publish-web.sh 使用）
# nginx 的 alias 应指向 <DAILY_CARD_WEB_ROOT>/current/
# DAILY_CARD_WEB_ROOT=/opt/daily-card-web
# DAILY_CARD_WEB_KEEP=5
